'From Pharo11.0.0 of 20 October 2025 [Build information: Pharo-11.0.0+build.750.sha.963dc3a7de9ee8e5543f6e62d25a2a283f7dcd48 (64 Bit)] on 20 October 2026 at 10:47:26.231807 pm'!TestCase subclass: #SportsPersistenceTest	instanceVariableNames: ''	classVariableNames: ''	package: 'SportsProject'!!SportsPersistenceTest methodsFor: 'tests' stamp: 'YarynaHrynko 10/20/2026 22:46'!testInMemoryDatabase    | persistence athletes storedAthletes |    persistence := SportsPersistence new.    self assert: persistence getAllAthletes size equals: 0.    athletes := persistence loadFromJSON.    athletes do: [ :athlete |        persistence addAthlete: athlete    ].    storedAthletes := persistence getAllAthletes.    self assert: storedAthletes size equals: 2.    self assert: storedAthletes first surname equals: 'Svitolina'.    self assert: storedAthletes second surname equals: 'Mudryk'.    persistence clearDatabase.    self assert: persistence getAllAthletes size equals: 0.! !!SportsPersistenceTest methodsFor: 'tests' stamp: 'YarynaHrynko 10/20/2026 22:45'!testLoadFromJSON    | persistence athletes tennis football |    persistence := SportsPersistence new.    athletes := persistence loadFromJSON.    self assert: athletes size equals: 2.    tennis := athletes detect: [ :each |        each isKindOf: TennisPlayer    ].    football := athletes detect: [ :each |        each isKindOf: FootballPlayer    ].    self assert: tennis surname equals: 'Svitolina'.    self assert: tennis worldRanking equals: 15.    self assert: tennis earnings equals: 60000.    self assert: football surname equals: 'Mudryk'.    self assert: football club equals: 'Chelsea'.    self assert: football earnings equals: 3300000.! !!SportsPersistenceTest methodsFor: 'tests' stamp: 'YarynaHrynko 10/20/2026 22:44'!testLoadFromCSV    | persistence athletes tennis football |    persistence := SportsPersistence new.    athletes := persistence loadAthletesFromCSV.    self assert: athletes size equals: 2.    tennis := athletes detect: [ :each |        each isKindOf: TennisPlayer    ].    football := athletes detect: [ :each |        each isKindOf: FootballPlayer    ].    self assert: tennis surname equals: 'Svitolina'.    self assert: tennis worldRanking equals: 15.    self assert: tennis earnings equals: 60000.    self assert: football surname equals: 'Mudryk'.    self assert: football club equals: 'Chelsea'.    self assert: football earnings equals: 3300000.! !