TestCase subclass: #SportsCollectionTest	instanceVariableNames: 'demo'	classVariableNames: ''	package: 'pharo-sports-project'.SportsCollectionTest compile: 'setUp	super setUp.	demo := SportsDemo new.' classified: 'running'.SportsCollectionTest compile: 'testAdd	| p |	p := FootballPlayer new		surname: ''Dovbyk'';		age: 27;		citizenship: ''Ukraine'';		club: ''Roma'';		annualContract: 4000000;		goals: 15;		yourself.	demo sportsmen add: p.	self assert: demo sportsmen size equals: 6.	Transcript show: ''test add: ok''; cr.' classified: 'tests'.SportsCollectionTest compile: 'testRichest	| r |	r := demo richestSportspersonAndCheckFootball.	self assert: r surname equals: ''Haaland''.	self assert: (r isKindOf: FootballPlayer).	Transcript show: ''test richest: ok, max is ''; show: r surname; cr.' classified: 'tests'.SportsCollectionTest compile: 'testMath	| s1 s2 res |	s1 := demo sportsmen first.	s2 := demo sportsmen second.	res := s1 + s2.	(res isKindOf: Sportsperson)		ifTrue: [ self assert: res earnings equals: (s1 earnings + s2 earnings) ]		ifFalse: [ self assert: res equals: (s1 earnings + s2 earnings) ].	self assert: (s2 < s1).	Transcript show: ''test math: ok''; cr.' classified: 'tests'.SportsCollectionTest compile: 'testAge	| oldAge |	oldAge := demo sportsmen first age.	demo increaseAgeForAll.	self assert: demo sportsmen first age equals: oldAge + 1.	Transcript show: ''test age: ok''; cr.' classified: 'tests'.SportsCollectionTest compile: 'testFilterUa	| list |	list := demo ukrainianSportsmen.	self assert: list size equals: 3.	Transcript show: ''test ua filter: ok, count = 3''; cr.' classified: 'tests'.	SportsCollectionTest buildSuite run.