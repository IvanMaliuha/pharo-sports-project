TestCase subclass: #SportspersonTest	instanceVariableNames: ''	classVariableNames: ''	package: 'SportsProject-Tests'!!SportspersonTest methodsFor: 'tests' stamp: 'IvanMaliuha 10/18/2026 20:08'!testIncreaseAge    | player |    player := TennisPlayer new.    player age: 20.    player increaseAge.    self assert: player age equals: 21! !!SportspersonTest methodsFor: 'tests' stamp: 'IvanMaliuha 10/18/2026 20:08'!testFootballPlayerEarnings    | player |    player := FootballPlayer new.    player surname: 'Example'.    player age: 25.    player citizenship: 'Ukraine'.    player club: 'FC Lviv'.    player annualContract: 1000000.    player goals: 20.    self assert: player earnings equals: 1200000! !!SportspersonTest methodsFor: 'tests' stamp: 'IvanMaliuha 10/18/2026 20:08'!testComparisonByEarnings    | tennisPlayer footballPlayer |    tennisPlayer := TennisPlayer new.    tennisPlayer lastTournamentPrizes: #(10000 20000 30000).    footballPlayer := FootballPlayer new.    footballPlayer annualContract: 100000.    footballPlayer goals: 10.    self assert: footballPlayer earnings > tennisPlayer earnings.    self assert: footballPlayer > tennisPlayer.    self assert: tennisPlayer < footballPlayer! !!SportspersonTest methodsFor: 'tests' stamp: 'IvanMaliuha 10/18/2026 20:08'!testTennisPlayerEarnings    | player |    player := TennisPlayer new.    player surname: 'Svitolina'.    player age: 30.    player citizenship: 'Ukraine'.    player worldRanking: 20.    player lastTournamentPrizes: #(10000 25000 15000).    self assert: player earnings equals: 50000! !