Object subclass: #Sportsperson	instanceVariableNames: 'surname age citizenship'	classVariableNames: ''	package: 'SportsProject'!!Sportsperson commentStamp: 'IvanMaliuha 10/18/2026 19:53' prior: 0!Abstract base class representing a sportsperson.Stores surname, age and citizenship.Subclasses define their own earnings calculation.!!Sportsperson methodsFor: 'comparing' stamp: 'IvanMaliuha 10/18/2026 19:55'!> anotherSportsperson    ^ self earnings > anotherSportsperson earnings! !!Sportsperson methodsFor: 'comparing' stamp: 'IvanMaliuha 10/18/2026 19:55'!< anotherSportsperson    ^ self earnings < anotherSportsperson earnings! !!Sportsperson methodsFor: 'comparing' stamp: 'IvanMaliuha 10/18/2026 19:55'!<= anotherSportsperson    ^ self earnings <= anotherSportsperson earnings! !!Sportsperson methodsFor: 'arithmetic' stamp: 'IvanMaliuha 10/18/2026 19:56'!* anotherSportsperson    ^ self earnings * anotherSportsperson earnings! !!Sportsperson methodsFor: 'arithmetic' stamp: 'IvanMaliuha 10/18/2026 19:56'!/ anotherSportsperson    anotherSportsperson earnings = 0        ifTrue: [ self error: 'Division by zero' ].    ^ self earnings / anotherSportsperson earnings! !!Sportsperson methodsFor: 'arithmetic' stamp: 'IvanMaliuha 10/18/2026 19:56'!- anotherSportsperson    ^ self earnings - anotherSportsperson earnings! !!Sportsperson methodsFor: 'arithmetic' stamp: 'IvanMaliuha 10/18/2026 19:56'!+ anotherSportsperson    ^ self earnings + anotherSportsperson earnings! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:48'!age    ^ age! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:49'!citizenship    ^ citizenship! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:48'!age: anInteger    age := anInteger! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:50'!citizenship: aString    citizenship := aString! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:47'!surname    ^ surname! !!Sportsperson methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 19:47'!surname: aString    surname := aString! !!Sportsperson methodsFor: 'printing' stamp: 'IvanMaliuha 10/18/2026 19:58'!printOn: aStream    aStream        nextPutAll: self class name asString;        nextPutAll: ' ';        nextPutAll: surname;        nextPutAll: ', age: ';        print: age;        nextPutAll: ', citizenship: ';        print: citizenship;        nextPutAll: ', earnings: ';        print: self earnings! !!Sportsperson methodsFor: 'as yet unclassified' stamp: 'IvanMaliuha 10/18/2026 19:49'!increaseAge    age := age + 1! !!Sportsperson methodsFor: 'as yet unclassified' stamp: 'IvanMaliuha 10/18/2026 19:54'!earnings    self subclassResponsibility! !Sportsperson subclass: #FootballPlayer	instanceVariableNames: 'club annualContract goals'	classVariableNames: ''	package: 'SportsProject'!!FootballPlayer methodsFor: 'as yet unclassified' stamp: 'IvanMaliuha 10/18/2026 20:03'!earnings    ^ annualContract * (1 + (goals / 100))! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:02'!club    ^ club! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:03'!club: aString    club := aString! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:03'!annualContract    ^ annualContract! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:03'!goals    ^ goals! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:03'!annualContract: aNumber    annualContract := aNumber! !!FootballPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:03'!goals: anInteger    goals := anInteger! !Sportsperson subclass: #TennisPlayer	instanceVariableNames: 'worldRanking lastTournamentPrizes'	classVariableNames: ''	package: 'SportsProject'!!TennisPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:00'!worldRanking    ^ worldRanking! !!TennisPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:00'!worldRanking: anInteger    worldRanking := anInteger! !!TennisPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:01'!lastTournamentPrizes: aCollection    lastTournamentPrizes := aCollection! !!TennisPlayer methodsFor: 'accessing' stamp: 'IvanMaliuha 10/18/2026 20:00'!lastTournamentPrizes    ^ lastTournamentPrizes! !!TennisPlayer methodsFor: 'as yet unclassified' stamp: 'IvanMaliuha 10/18/2026 20:01'!earnings    ^ lastTournamentPrizes        inject: 0        into: [ :sum :prize | sum + prize ]! !