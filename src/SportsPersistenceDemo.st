'From Pharo11.0.0 of 20 October 2025 [Build information: Pharo-11.0.0+build.750.sha.963dc3a7de9ee8e5543f6e62d25a2a283f7dcd48 (64 Bit)] on 20 October 2026 at 10:52:55.580792 pm'!Object subclass: #SportsPersistenceDemo	instanceVariableNames: ''	classVariableNames: ''	package: 'SportsProject'!!SportsPersistenceDemo methodsFor: 'as yet unclassified' stamp: 'YarynaHrynko 10/20/2026 22:49'!demoCSV    | persistence athletes |    persistence := SportsPersistence new.    athletes := persistence loadAthletesFromCSV.    persistence saveToCSV: athletes.    ^ athletes collect: [ :athlete |        {            athlete surname.            athlete earnings        }    ]! !!SportsPersistenceDemo methodsFor: 'as yet unclassified' stamp: 'YarynaHrynko 10/20/2026 22:51'!demoJSON    | persistence athletes |    persistence := SportsPersistence new.    athletes := persistence loadFromJSON.    persistence saveToJSON: athletes.    ^ athletes collect: [ :athlete |        {            athlete surname.            athlete earnings        }    ]! !!SportsPersistenceDemo methodsFor: 'as yet unclassified' stamp: 'YarynaHrynko 10/20/2026 22:51'!demoInMemoryDatabase    | persistence athletes result |    persistence := SportsPersistence new.    athletes := persistence loadFromJSON.    athletes do: [ :athlete |        persistence addAthlete: athlete    ].    result := persistence getAllAthletes collect: [ :athlete |        {            athlete surname.            athlete earnings        }    ].    persistence clearDatabase.    ^ result! !