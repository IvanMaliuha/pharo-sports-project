'From Pharo11.0.0 of 20 October 2025 [Build information: Pharo-11.0.0+build.750.sha.963dc3a7de9ee8e5543f6e62d25a2a283f7dcd48 (64 Bit)] on 20 October 2026 at 10:33:11.180964 pm'!Object subclass: #SportsPersistence	instanceVariableNames: 'database'	classVariableNames: ''	package: 'SportsProject'!!SportsPersistence methodsFor: 'initialization' stamp: 'YarynaHrynko 10/20/2026 22:13'!initialize    super initialize.    database := OrderedCollection new.! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 22:12'!loadFromJSON    | file data athletes |    file := self dataDirectory / 'sportspeople.json'.    file exists ifFalse: [ ^ OrderedCollection new ].    data := STONJSON fromString: file contents.    athletes := OrderedCollection new.    data do: [ :item |        | athlete type |        type := item at: 'type'.        type = 'TennisPlayer'            ifTrue: [                athlete := TennisPlayer new.                athlete worldRanking: (item at: 'worldRanking').                athlete lastTournamentPrizes:                    (item at: 'lastTournamentPrizes') asOrderedCollection            ]            ifFalse: [                type = 'FootballPlayer'                    ifTrue: [                        athlete := FootballPlayer new.                        athlete club: (item at: 'club').                        athlete annualContract: (item at: 'annualContract').                        athlete goals: (item at: 'goals')                    ]            ].        athlete ifNotNil: [            athlete surname: (item at: 'surname').            athlete age: (item at: 'age').            athlete citizenship: (item at: 'citizenship').            athletes add: athlete        ]    ].    ^ athletes! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 21:36'!saveToCSV: athletes    | file |    file := self dataDirectory / 'sportspeople.csv'.    file ensureDelete.file writeStreamDo: [ :stream |        stream nextPutAll:            'type,surname,age,citizenship,worldRanking,lastTournamentPrizes,club,annualContract,goals'.        stream cr.        athletes do: [ :athlete |            | fields |            fields := OrderedCollection new.            fields add: athlete class name asString.            fields add: athlete surname.            fields add: athlete age asString.            fields add: athlete citizenship.            (athlete isKindOf: TennisPlayer)                ifTrue: [                    fields add: athlete worldRanking asString.                    fields add: (';' join:    (athlete lastTournamentPrizes collect: [ :prize |        prize asString    ])).                    fields addAll: #('' '' '') ]                ifFalse: [                    fields addAll: #('' '').                    fields add: athlete club.                    fields add: athlete annualContract asString.                    fields add: athlete goals asString ].            stream nextPutAll: (',' join: fields).            stream cr        ]    ].! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 21:13'!dataDirectory    ^ FileLocator documents / 'pharo-sports-project' / 'data'! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 21:31'!loadAthletesFromCSV    | lines athletes |    lines := self loadFromCSV.    athletes := OrderedCollection new.    lines allButFirst do: [ :line |        | fields athlete |        fields := line splitOn: ','.        fields first = 'TennisPlayer'            ifTrue: [                athlete := TennisPlayer new.                athlete worldRanking: fields fifth asNumber.                athlete lastTournamentPrizes:    ((fields sixth splitOn: ';') collect: [ :prize |        prize asNumber    ]).            ]            ifFalse: [                fields first = 'FootballPlayer'                    ifTrue: [                        athlete := FootballPlayer new.                        athlete club: fields seventh.                        athlete annualContract: fields eighth asNumber.                        athlete goals: fields ninth asNumber                    ]                    ifFalse: [                        self error: 'Unknown athlete type'                    ]            ].        athlete surname: fields second.        athlete age: fields third asNumber.        athlete citizenship: fields fourth.        athletes add: athlete    ].    ^ athletes! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 21:24'!loadFromCSV    | file lines |    file := self dataDirectory / 'sportspeople.csv'.    file exists ifFalse: [        self error: 'CSV file not found'    ].    lines := OrderedCollection new.    file readStreamDo: [ :stream |        [ stream atEnd ] whileFalse: [            lines add: stream nextLine        ]    ].    ^ lines! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 22:16'!addAthlete: anAthlete    database add: anAthlete.    ^ anAthlete! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 22:10'!saveToJSON: athletes    | file data |    file := self dataDirectory / 'sportspeople.json'.    data := athletes collect: [ :athlete |        (athlete isKindOf: TennisPlayer)            ifTrue: [                Dictionary new                    at: 'type' put: 'TennisPlayer';                    at: 'surname' put: athlete surname;                    at: 'age' put: athlete age;                    at: 'citizenship' put: athlete citizenship;                    at: 'worldRanking' put: athlete worldRanking;                    at: 'lastTournamentPrizes' put: athlete lastTournamentPrizes asArray;                    yourself            ]            ifFalse: [                Dictionary new                    at: 'type' put: 'FootballPlayer';                    at: 'surname' put: athlete surname;                    at: 'age' put: athlete age;                    at: 'citizenship' put: athlete citizenship;                    at: 'club' put: athlete club;                    at: 'annualContract' put: athlete annualContract;                    at: 'goals' put: athlete goals;                    yourself            ]    ].    file parent ensureCreateDirectory.    file writeStreamDo: [ :stream |        stream nextPutAll: (STONJSON toString: data asArray)    ].! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 22:17'!getAllAthletes    ^ database copy! !!SportsPersistence methodsFor: 'persistence' stamp: 'YarynaHrynko 10/20/2026 22:19'!clearDatabase    database removeAll.! !