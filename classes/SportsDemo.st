Object subclass: #SportsDemo	instanceVariableNames: 'sportsmen'	classVariableNames: ''	package: 'pharo-sports-project'.SportsDemo compile: 'initialize	super initialize.	sportsmen := OrderedCollection new.	self createDefaultSportsmen.' classified: 'initialization'."Колекція з 5 спортсменів"SportsDemo compile: 'createDefaultSportsmen	| f1 f2 f3 t1 t2 |	f1 := FootballPlayer new		surname: ''Shevchenko'';		age: 47;		citizenship: ''Ukraine'';		club: ''Milan'';		annualContract: 5000000;		goals: 25;		yourself.	f2 := FootballPlayer new		surname: ''Mudryk'';		age: 23;		citizenship: ''Ukraine'';		club: ''Chelsea'';		annualContract: 3500000;		goals: 10;		yourself.	f3 := FootballPlayer new		surname: ''Haaland'';		age: 24;		citizenship: ''Norway'';		club: ''Manchester City'';		annualContract: 20000000;		goals: 40;		yourself.	t1 := TennisPlayer new		surname: ''Svitolina'';		age: 29;		citizenship: ''Ukraine'';		worldRanking: 17;		lastTournamentPrizes: #(350000 450000 400000);		yourself.	t2 := TennisPlayer new		surname: ''Alcaraz'';		age: 21;		citizenship: ''Spain'';		worldRanking: 2;		lastTournamentPrizes: #(2500000 3000000 4000000);		yourself.	sportsmen addAll: { f1. f2. f3. t1. t2 }.' classified: 'initialization'.SportsDemo compile: 'sportsmen	^ sportsmen' classified: 'accessing'."Виведення всіх елементів колекції"SportsDemo compile: 'displayAll	| result |	Transcript open; clear.	Transcript show: ''=== ВСІ ЕЛЕМЕНТИ КОЛЕКЦІЇ  ===''; cr.	sportsmen do: [ :s |		Transcript show: s printString; cr ].		result := String streamContents: [ :stream |		sportsmen do: [ :s | 			stream nextPutAll: s printString; cr ] ].	UIManager default longMessage: result title: ''Список усіх спортсменів''.' classified: 'displaying'."Діалог вибору способу внесення: з клавіатури чи з файлу"SportsDemo compile: 'addNewSportspersonDialog	| modeChoice |	modeChoice := UIManager default 		chooseFrom: #(''Ввести вручну з клавіатури'' ''Прочитати з файлу'') 		title: ''Як саме ви хочете внести спортсмена?''.		modeChoice = 1 ifTrue: [ self inputSportspersonFromKeyboard ].	modeChoice = 2 ifTrue: [ self importSportsmenFromFile ].' classified: 'dialogs'."1. Введення вручну з клавіатури"SportsDemo compile: 'inputSportspersonFromKeyboard	| typeChoice surname age citizenship obj |	typeChoice := UIManager default 		chooseFrom: #(''Футболіст (FootballPlayer)'' ''Тенісист (TennisPlayer)'') 		title: ''Оберіть тип нового спортсмена:''.	typeChoice = 0 ifTrue: [ ^ nil ].	surname := UIManager default request: ''Введіть прізвище:'' initialAnswer: ''Dovbyk''.	(surname isNil or: [ surname isEmpty ]) ifTrue: [ ^ nil ].	age := (UIManager default request: ''Введіть вік:'' initialAnswer: ''27'') asInteger.	citizenship := UIManager default request: ''Введіть громадянство:'' initialAnswer: ''Ukraine''.	typeChoice = 1 ifTrue: [ 		| club contract goals |		club := UIManager default request: ''Введіть клуб:'' initialAnswer: ''Roma''.		contract := (UIManager default request: ''Введіть річний контракт ($):'' initialAnswer: ''40000000'') asNumber.		goals := (UIManager default request: ''Введіть кількість голів:'' initialAnswer: ''15'') asInteger.		obj := FootballPlayer new			surname: surname;			age: age;			citizenship: citizenship;			club: club;			annualContract: contract;			goals: goals;			yourself.	] ifFalse: [ 		| ranking p1 p2 p3 |		ranking := (UIManager default request: ''Введіть світовий рейтинг:'' initialAnswer: ''30'') asInteger.		p1 := (UIManager default request: ''Призові за турнір 1 ($):'' initialAnswer: ''800000'') asNumber.		p2 := (UIManager default request: ''Призові за турнір 2 ($):'' initialAnswer: ''1200000'') asNumber.		p3 := (UIManager default request: ''Призові за турнір 3 ($):'' initialAnswer: ''950000'') asNumber.		obj := TennisPlayer new			surname: surname;			age: age;			citizenship: citizenship;			worldRanking: ranking;			lastTournamentPrizes: (Array with: p1 with: p2 with: p3);			yourself.	].	sportsmen add: obj.	UIManager default inform: ''Спортсмена '' , surname , '' успішно додано вручну!''.	^ obj' classified: 'dialogs'."2. Читання з файлу"SportsDemo compile: 'importSportsmenFromFile	| repo dir dataFile fileName lines count |	repo := IceRepository registry detect: [ :r | r name = ''pharo-sports-project'' ].	dir := repo location.		fileName := UIManager default 		request: ''Введіть ім''''я файлу для читання:'' 		initialAnswer: ''sportsmen_data.txt''.	(fileName isNil or: [ fileName isEmpty ]) ifTrue: [ ^ self ].		dataFile := dir / fileName.	"Зчитуємо рядки файлу"	lines := dataFile readStreamDo: [ :s | s contents lines ].	count := 0.	lines do: [ :line |		| parts type surname age citizenship |		parts := line trimBoth findTokens: '',''.		parts size >= 4 ifTrue: [ 			type := parts first.			surname := parts second.			age := parts third asInteger.			citizenship := parts fourth.			(type = ''Football'' and: [ parts size >= 7 ]) ifTrue: [ 				sportsmen add: (FootballPlayer new					surname: surname;					age: age;					citizenship: citizenship;					club: parts fifth;					annualContract: parts sixth asNumber;					goals: parts seventh asInteger;					yourself).				count := count + 1.			].			(type = ''Tennis'' and: [ parts size >= 8 ]) ifTrue: [ 				sportsmen add: (TennisPlayer new					surname: surname;					age: age;					citizenship: citizenship;					worldRanking: parts fifth asInteger;					lastTournamentPrizes: (Array with: parts sixth asNumber with: parts seventh asNumber with: parts eighth asNumber);					yourself).				count := count + 1.			].		].	].	UIManager default inform: ''Успішно додано з файлу: '' , count printString , '' спортсменів!''' classified: 'file-import'."Знаходження об'єкта з найбільшим прибутком і перевірка, чи це футболіст"SportsDemo compile: 'richestSportspersonAndCheckFootball	| richest isFootball message |	sportsmen ifEmpty: [ 		UIManager default message: ''Колекція порожня!'' title: ''Помилка''.		^ nil ].			richest := sportsmen detectMax: [ :s | s earnings ].	isFootball := richest isKindOf: FootballPlayer.		message := String streamContents: [ :st |		st nextPutAll: ''НАЙБІЛЬШИЙ ПРИБУТОК''; cr; cr;		   nextPutAll: ''• Прізвище: ''; nextPutAll: richest surname; cr;		   nextPutAll: ''• Вид спорту: ''; nextPutAll: richest class name; cr;		   nextPutAll: ''• Дохід: $''; nextPutAll: richest earnings printString; cr;		   nextPutAll: ''• Громадянство: ''; nextPutAll: richest citizenship; cr; cr;		   nextPutAll: ''Чи є цей спортсмен футболістом? -> '';		   nextPutAll: (isFootball ifTrue: [ ''ТАК'' ] ifFalse: [ ''НІ'' ]).	].	Transcript open; show: message; cr.	UIManager default message: message title: ''Результат пошуку найбагатшого''.	^ richest' classified: 'operations'."Арифметичні дії"SportsDemo compile: 'demonstrateArithmetic	| s1 s2 sum diff message |	sportsmen size < 2 ifTrue: [ ^ self ].	s1 := sportsmen first.	s2 := sportsmen second.		sum := s1 + s2.	diff := s1 - s2.		message := String streamContents: [ :st |		st nextPutAll: ''=== Арифметичні дії ===''; cr;		   nextPutAll: ''Спортсмен 1: ''; nextPutAll: s1 surname; 		   nextPutAll: '' (дохід: $''; nextPutAll: s1 earnings printString; nextPutAll: '')''; cr;		   nextPutAll: ''Спортсмен 2: ''; nextPutAll: s2 surname; 		   nextPutAll: '' (дохід: $''; nextPutAll: s2 earnings printString; nextPutAll: '')''; cr;		   nextPutAll: ''--------------------------------------------''; cr;		   nextPutAll: ''Сума доходів (s1 + s2): ''; nextPutAll: sum printString; cr;		   nextPutAll: ''Різниця доходів (s1 - s2): ''; nextPutAll: diff printString; cr;		   nextPutAll: ''Порівняння (s1 < s2): ''; nextPutAll: (s1 < s2) printString; cr;		   nextPutAll: ''Порівняння (s1 <= s2): ''; nextPutAll: (s1 <= s2) printString; cr.	].	Transcript show: message; cr.	UIManager default longMessage: message title: ''Результати арифметичних операцій''.' classified: 'operations'."Збільшення віку кожного спортсмена на 1 рік"SportsDemo compile: 'increaseAgeForAll	sportsmen do: [ :s | s age: s age + 1 ].	UIManager default inform: ''Вік кожного спортсмена успішно збільшено на 1 рік!''.' classified: 'operations'."Українські спортсмени"SportsDemo compile: 'ukrainianSportsmen	| uaCollection |	uaCollection := sportsmen select: [ :s | s citizenship = ''Ukraine'' ].	Transcript show: ''=== НОВА КОЛЕКЦІЯ: УКРАЇНСЬКІ СПОРТСМЕНИ ===''; cr.	uaCollection do: [ :s | Transcript show: s printString; cr ].	^ uaCollection' classified: 'operations'.	SportsDemo new runFullDemonstration.